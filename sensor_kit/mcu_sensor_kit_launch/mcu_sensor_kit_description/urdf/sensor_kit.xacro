<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:arg name="config_dir" default="$(find mcu_sensor_kit_description)/config"/>
    <xacro:property name="sensor_kit_base_link" value="sensor_kit_base_link"/>
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}"/>

    <xacro:macro name="mcu_sensor_link" params="name">
      <joint name="${name}_joint" type="fixed">
        <origin
          xyz="${calibration['sensor_kit_base_link'][name]['x']}
               ${calibration['sensor_kit_base_link'][name]['y']}
               ${calibration['sensor_kit_base_link'][name]['z']}"
          rpy="${calibration['sensor_kit_base_link'][name]['roll']}
               ${calibration['sensor_kit_base_link'][name]['pitch']}
               ${calibration['sensor_kit_base_link'][name]['yaw']}"
        />
        <parent link="${sensor_kit_base_link}"/>
        <child link="${name}"/>
      </joint>
      <link name="${name}"/>
    </xacro:macro>

    <!-- Frame ids match atv_calib.yaml. Camera frames are optical frames. -->
    <xacro:mcu_sensor_link name="imu_vn_100"/>
    <xacro:mcu_sensor_link name="vn200_imu"/>
    <xacro:mcu_sensor_link name="d435i_imu"/>
    <xacro:mcu_sensor_link name="d455b_imu"/>
    <xacro:mcu_sensor_link name="os_imu"/>
    <xacro:mcu_sensor_link name="os_sensor"/>
    <xacro:mcu_sensor_link name="livox_frame"/>
    <xacro:mcu_sensor_link name="d435i_infra1"/>
    <xacro:mcu_sensor_link name="d435i_infra2"/>
    <xacro:mcu_sensor_link name="d455b_color"/>
    <xacro:mcu_sensor_link name="d455b_infra1"/>
    <xacro:mcu_sensor_link name="d455b_infra2"/>
  </xacro:macro>
</robot>
